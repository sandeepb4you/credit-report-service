# Template for the compose stack's env file. Copy to .env next to
# docker-compose.yml on the server (/opt/scorr/.env) and fill in.
#
# This file is the ONLY one in deploy/ that git tracks — .gitignore excludes
# .env and .env.* precisely so a filled-in copy cannot be committed. Keep real
# values out of here.
#
# Compose reads this file twice: once to interpolate ${VAR} in
# docker-compose.yml, and once as env_file to inject the variables into the api
# container. Every key the service understands is settable this way; the name is
# the config key uppercased with dots and dashes as underscores
# (sms.msg91.auth-key -> SMS_MSG91_AUTH_KEY), and it overrides the config.yaml
# baked into the image.

# ---- image ------------------------------------------------------------------
ECR_REGISTRY=<account>.dkr.ecr.ap-south-1.amazonaws.com
# A specific git SHA rolls back; deploy.sh pushes every SHA.
IMAGE_TAG=latest

# ---- database ---------------------------------------------------------------
# Used by both services: postgres initialises with it, and the api's DB_URL in
# docker-compose.yml interpolates it.
DB_PASSWORD=<generate: openssl rand -base64 24>

# ---- auth -------------------------------------------------------------------
AUTH_JWT_SECRET=<generate: openssl rand -base64 48>
# Access-token lifetime IS the revocation lag — a revoked device keeps working
# until its token expires. Keep it short in production; clients refresh on 401.
AUTH_ACCESS_TTL=15m

# Comma-separated. The deployed web app plus anything else that calls the API
# from a browser; a local dev server needs its own origin listed here.
SERVER_CORS_ORIGINS=https://www.myscorr.com

# ---- SMS: phone sign-in OTP (MSG91) -----------------------------------------
# SECRET. Empty (or absent) -> the stub sender: no SMS is sent, and because no
# sender logs the code, the only way through an OTP screen is the master OTP.
# Check the boot line for which mode you are in: sms_stub=true|false.
#
# MSG91 filters on the CALLING host's IP. Whitelist the box's Elastic IP under
# Settings -> IP Security in the MSG91 panel, or every send comes back rejected
# — a key that works from a laptop fails from EC2 for this reason alone, and
# MSG91 reports it as HTTP 200 with {"type":"error"}, not as a failure status.
SMS_MSG91_AUTH_KEY=

# The rest have working defaults in docker-compose.yml; set them only to
# override. SMS_MSG91_TEMPLATE_ID is MSG91's own template id from the panel,
# not the 19-digit DLT id the wording is registered under.
#SMS_PROVIDER=msg91
#SMS_MSG91_TEMPLATE_ID=
#SMS_MSG91_SENDER_ID=REAOUT
#SMS_MSG91_OTP_VAR=OTP
# Android auto-read; needs a DLT template that ENDS in a variable and stays
# under 140 bytes with the hash appended. See docs/sms-otp.md before setting.
#SMS_MSG91_APP_SIGNATURE=
#SMS_MSG91_APP_SIGNATURE_VAR=

# ---- email ------------------------------------------------------------------
# Empty MAIL_HOST -> stub: signup and password-reset mail is skipped. The code
# is NOT logged in that mode either, so leaving this unset makes email sign-up
# and password reset uncompletable except via the master OTP.
#MAIL_HOST=
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_FROM=

# ---- payments (Cashfree) ----------------------------------------------------
CASHFREE_MODE=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_RETURN_URL=https://www.myscorr.com/payment/result?order_id={order_id}
CASHFREE_NOTIFY_URL=https://api.myscorr.com/api/payments/cashfree/webhook

# ---- credit bureau (Digitap) ------------------------------------------------
# Both empty -> offline stub client, no real bureau pulls.
#DIGITAP_CLIENT_ID=
#DIGITAP_CLIENT_SECRET=

# ---- demo mode --------------------------------------------------------------
# Bypasses real KYC verification. UAT and demos only — never with real users.
DEMO_ENABLED=false
