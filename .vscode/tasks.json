{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "go build",
      "type": "shell",
      "command": "go build ./...",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$go"]
    },
    {
      "label": "go test",
      "type": "shell",
      "command": "go test ./...",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$go"]
    },
    {
      "label": "go vet",
      "type": "shell",
      "command": "go vet ./...",
      "problemMatcher": ["$go"]
    },
    {
      // Regenerate docs/ after editing // @... handler annotations.
      "label": "swag init",
      "type": "shell",
      "command": "swag init -g cmd/server/main.go -o docs --parseDependency --parseInternal",
      "problemMatcher": []
    }
  ]
}
