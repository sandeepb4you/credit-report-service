# Go binaries
/bin/
*.exe
*.test
*.out

# Delve debug binaries from the VS Code / GoLand debugger (~50MB each)
__debug_bin*

# Local data (PAN image uploads)
/data/

# Editor / IDE
/.idea/
/.vscode/
*.iml

/.zcode/

# OS files
.DS_Store
Thumbs.db

# Local env / secrets
.env
.env.*
config.local.yaml
# Per-developer profile configs hold real upstream credentials (Cashfree,
# Digitap, DB). Keep them local; commit config.dev.yaml.example instead.
config.dev.yaml
config.*.local.yaml

# Build cache
*.prof
